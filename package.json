{
  "name": "demoblaze-playwright-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright JavaScript BDD automation for Demoblaze",
  "scripts": {
    "test": "npm run test:all",
    "test:all": "cucumber-js",
    "test:banking": "cucumber-js --tags \"@banking\"",
    "test:banking:headed": "cross-env HEADED=true cucumber-js --tags \"@banking\"",
    "test:demoqa": "cucumber-js --tags \"@demoqa\"",
    "test:demoqa:headed": "cross-env HEADED=true cucumber-js --tags \"@demoqa\"",
    "test:demoblaze": "cucumber-js --tags \"@demoblaze\"",
    "test:demoblaze:headed": "cross-env HEADED=true cucumber-js --tags \"@demoblaze\"",
    "test:headed": "cross-env HEADED=true cucumber-js",
    "test:debug": "cross-env PWDEBUG=1 cucumber-js",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "cross-env": "^10.0.0",
    "playwright": "^1.55.0",
    "xlsx": "^0.18.5"
  }
}
